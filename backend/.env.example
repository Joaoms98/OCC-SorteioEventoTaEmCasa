# Copy to backend/.env for local development.

# PostgreSQL connection used by the app (on Neon: the *pooled* connection string).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/occ_raffle"
# Optional: direct (non-pooled) connection used only by migrations. Falls back to DATABASE_URL.
# DIRECT_URL="postgresql://..."

# Password for the organizers' admin area (min. 8 characters; 12+ and not this example in production).
ADMIN_PASSWORD="troque-esta-senha"
# Secret used to sign login tokens (min. 32 characters). Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-with-32-plus-chars"
JWT_EXPIRES_IN_HOURS=12

PORT=3333
# Number of reverse proxies in front of the app (Render: 1). Needed for per-IP rate limiting.
TRUST_PROXY=0
# Só atrás de uma borda que sempre envia o IP real do visitante num cabeçalho (Render: cf-connecting-ip).
# CLIENT_IP_HEADER="cf-connecting-ip"
# Suspense (seconds) shown to everyone before the winner is revealed in the live draw.
DRAW_SUSPENSE_SECONDS=5
# E-mail with the registration code. "console" (development) shows the code on screen;
# production requires "brevo" with an API key and a sender verified in Brevo.

EMAIL_PROVIDER=console
# BREVO_API_KEY="xkeysib-..."
# EMAIL_FROM="sorteio@seudominio.com.br"
# EMAIL_FROM_NAME="Sorteio OCC"
# Logo no e-mail: precisa de um endereço público. Em produção ele é montado sozinho a partir do
# endereço do app (PUBLIC_URL, ou o que o Render informa); EMAIL_LOGO_URL força outro endereço.
# PUBLIC_URL="https://sorteio.seudominio.com.br"
# EMAIL_LOGO_URL="https://.../occ-logo-email.png"

# Only when the frontend is hosted on another domain (comma separated).
# CORS_ORIGINS="https://sorteio.vercel.app"
